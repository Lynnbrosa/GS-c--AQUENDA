{
  "Urls": "http://0.0.0.0:5000",
  "ConnectionStrings": {
    "Default": "Data Source=aquenda.db"
  },
  "Mqtt": {
    "Habilitado": true,
    "Host": "broker.hivemq.com",
    "Porta": 1883,
    "Topico": "aquenda/casa/+/vagas"
  },
  "Chat": {
    "DiasRetencao": 7,
    "IntervaloLimpezaMinutos": 60
  },
  "FontesExternas": {
    "OverpassUrl": "https://overpass-api.de/api/interpreter",
    "BrasilApiUrl": "https://brasilapi.com.br/api/",
    "TimeoutSegundos": 30
  },
  "Seguranca": {
    "ChaveOperador": ""
  },
  "Banco": {
    "InicializarAoSubir": true,
    "Semear": true
  },
  "Swagger": {
    "Habilitado": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*"
}
